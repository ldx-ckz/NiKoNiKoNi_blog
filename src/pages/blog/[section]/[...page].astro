---
import type { GetStaticPaths } from "astro";
import AxiPostCard from "../../../components/AxiPostCard.astro";
import BlogSectionSidebar from "../../../components/BlogSectionSidebar.astro";
import Pagination from "../../../components/control/Pagination.astro";
import UiText from "../../../components/UiText.astro";
import MainGridLayout from "../../../layouts/MainGridLayout.astro";
import { getSortedPosts } from "../../../utils/content-utils";

const PAGE_SIZE = 10;

export const getStaticPaths = (async ({ paginate }) => {
	const posts = await getSortedPosts();
	const sections = [
		{
			slug: "notes",
			zh: "笔记",
			en: "Notes",
		},
		{
			slug: "technical",
			zh: "技术",
			en: "Technical",
		},
		{
			slug: "daily-life",
			zh: "日常",
			en: "Daily Life",
		},
	];
	const containsAny = (values: string[], keywords: string[]) =>
		values.some((value) => {
			const normalized = value.toLowerCase();
			return keywords.some((keyword) => normalized.includes(keyword));
		});
	const isNotesPost = (post: (typeof posts)[number]) =>
		containsAny(
			[post.id, post.data.category || "", ...post.data.tags],
			[
				"analysis",
				"probability",
				"propability",
				"math",
				"notes",
				"数学",
				"概率",
				"笔记",
			],
		);
	const isDailyPost = (post: (typeof posts)[number]) =>
		containsAny(
			[post.id, post.data.category || "", ...post.data.tags],
			["daily", "life", "diary", "生活", "日常", "随笔"],
		);

	return sections.flatMap((section) => {
		const sectionPosts = posts.filter((post) => {
			if (section.slug === "notes") return isNotesPost(post);
			if (section.slug === "daily-life") return isDailyPost(post);
			return !isNotesPost(post) && !isDailyPost(post);
		});
		return paginate(sectionPosts, {
			pageSize: 10,
			params: { section: section.slug },
			props: { section, totalPosts: sectionPosts.length },
		});
	});
}) satisfies GetStaticPaths;

const { section, totalPosts, page } = Astro.props;
const pageOffset = (page.currentPage - 1) * PAGE_SIZE;
---

<MainGridLayout title={section.zh} titleEn={section.en} hideSidebar>
	<header class="section-hero onload-animation">
		<h1><UiText zh={section.zh} en={section.en} /></h1>
		<span class="post-count">
			<UiText zh={`${totalPosts} 篇文章`} en={`${totalPosts} posts`} />
		</span>
	</header>

	<div class="section-layout">
		<section class="post-stream" aria-label={`${section.en} posts`}>
			{page.data.length > 0 ? (
				<div class="post-list">
					{page.data.map((entry, index) => (
						<AxiPostCard entry={entry} index={pageOffset + index} />
					))}
				</div>
			) : (
				<div class="empty-state card-base onload-animation">
					<span class="ui-lang-zh">这个栏目还没有文章，下一篇也许就在路上。</span>
					<span class="ui-lang-en">No posts here yet. The first one may already be on its way.</span>
				</div>
			)}

			{page.lastPage > 1 && (
				<Pagination
					class="mx-auto mt-12 w-full onload-animation"
					page={page}
					baseUrl={`/blog/${section.slug}/`}
				/>
			)}
		</section>

		<BlogSectionSidebar />
	</div>
</MainGridLayout>

<style>
	.section-hero {
		@apply relative mb-7 px-1 py-2;
	}

	.section-hero h1 {
		@apply mb-3 text-3xl font-black text-black/90 dark:text-white/90 md:text-4xl;
	}

	.post-count {
		@apply inline-flex rounded-lg bg-[var(--btn-plain-bg-hover)] px-3 py-1.5 text-xs font-bold text-black/60 dark:text-white/60;
	}

	.empty-state {
		@apply rounded-[var(--radius-large)] p-10 text-center text-black/50 dark:text-white/50;
	}

	.section-layout {
		@apply grid items-start gap-8 lg:grid-cols-[minmax(0,3fr)_minmax(15rem,1fr)];
	}

	.post-stream {
		@apply min-w-0;
	}

	.post-list {
		@apply flex flex-col gap-4;
	}
</style>
