---
import type { GetStaticPaths } from "astro";
import { Icon } from "astro-icon/components";
import AxiPostCard from "../../components/AxiPostCard.astro";
import BlogSectionSidebar from "../../components/BlogSectionSidebar.astro";
import MainGridLayout from "../../layouts/MainGridLayout.astro";
import { getSortedPosts } from "../../utils/content-utils";
import { url } from "../../utils/url-utils";

export const getStaticPaths = (() => {
	const sections = [
		{
			slug: "notes",
			zh: "学习笔记",
			en: "Notes",
			descriptionZh: "数学、概率与人工智能基础知识的系统整理。",
			descriptionEn: "Structured notes on mathematics, probability, and AI foundations.",
		},
		{
			slug: "technical",
			zh: "技术文章",
			en: "Technical",
			descriptionZh: "模型、代码、工具与工程实践中的方法和复盘。",
			descriptionEn: "Models, code, tools, and lessons from engineering practice.",
		},
		{
			slug: "daily-life",
			zh: "日常记录",
			en: "Daily Life",
			descriptionZh: "学习之外的观察、生活片段与阶段性思考。",
			descriptionEn: "Observations, moments, and reflections beyond technical study.",
		},
	];

	return sections.map((section) => ({
		params: { section: section.slug },
		props: { section },
	}));
}) satisfies GetStaticPaths;

const { section } = Astro.props;
const posts = await getSortedPosts();

const containsAny = (values: string[], keywords: string[]) =>
	values.some((value) => {
		const normalized = value.toLowerCase();
		return keywords.some((keyword) => normalized.includes(keyword));
	});

const isNotesPost = (post: (typeof posts)[number]) =>
	containsAny(
		[post.id, post.data.category || "", ...post.data.tags],
		["analysis", "probability", "propability", "math", "notes", "数学", "概率", "笔记"],
	);

const isDailyPost = (post: (typeof posts)[number]) =>
	containsAny(
		[post.id, post.data.category || "", ...post.data.tags],
		["daily", "life", "diary", "生活", "日常", "随笔"],
	);

const sectionPosts = posts.filter((post) => {
	if (section.slug === "notes") return isNotesPost(post);
	if (section.slug === "daily-life") return isDailyPost(post);
	return !isNotesPost(post) && !isDailyPost(post);
});
---

<MainGridLayout title={`${section.en} - nikonikoni's blog`} hideSidebar>
	<header class="section-hero onload-animation">
		<p>Blog / {section.en}</p>
		<h1>
			<span class="ui-lang-zh">{section.zh}</span>
			<span class="ui-lang-en">{section.en}</span>
		</h1>
		<div>
			<span class="ui-lang-zh">{section.descriptionZh}</span>
			<span class="ui-lang-en">{section.descriptionEn}</span>
		</div>
		<span class="post-count">
			{sectionPosts.length}
			<span class="ui-lang-zh"> 篇文章</span>
			<span class="ui-lang-en"> posts</span>
		</span>
	</header>

	<div class="section-layout">
		<section class="post-stream" aria-label={`${section.en} posts`}>
			<div class="stream-toolbar">
				<p>
					<span class="ui-lang-zh">共 {sectionPosts.length} 篇文章</span>
					<span class="ui-lang-en">{sectionPosts.length} posts</span>
				</p>
				<a href={url("/archive/")}>
					<span class="ui-lang-zh">按年份查看</span>
					<span class="ui-lang-en">View by year</span>
					<Icon name="material-symbols:arrow-forward-rounded" />
				</a>
			</div>

			{sectionPosts.length > 0 ? (
				<div class="post-list">
					{sectionPosts.map((entry, index) => (
						<AxiPostCard entry={entry} index={index} />
					))}
				</div>
			) : (
				<div class="empty-state card-base onload-animation">
					<span class="ui-lang-zh">这个栏目还没有文章，下一篇也许就在路上。</span>
					<span class="ui-lang-en">No posts here yet. The first one may already be on its way.</span>
				</div>
			)}
		</section>

		<BlogSectionSidebar />
	</div>
</MainGridLayout>

<style>
	.section-hero {
		@apply relative mb-7 px-1 py-2;
	}

	.section-hero > p {
		@apply mb-2 text-xs font-bold uppercase tracking-[0.2em] text-[var(--primary)];
	}

	.section-hero h1 {
		@apply mb-2 text-3xl font-black text-black/90 dark:text-white/90 md:text-4xl;
	}

	.section-hero > div {
		@apply max-w-2xl text-sm leading-7 text-black/55 dark:text-white/55;
	}

	.post-count {
		@apply mt-3 inline-flex rounded-lg bg-[var(--btn-plain-bg-hover)] px-3 py-1.5 text-xs font-bold text-black/60 dark:text-white/60;
	}

	.empty-state {
		@apply rounded-[var(--radius-large)] p-10 text-center text-black/50 dark:text-white/50;
	}

	.section-layout {
		@apply grid items-start gap-8 lg:grid-cols-[minmax(0,3fr)_minmax(15rem,1fr)];
	}

	.post-stream {
		@apply min-w-0;
	}

	.stream-toolbar {
		@apply mb-4 flex items-center justify-between gap-4 px-1 text-sm text-black/50 dark:text-white/50;
	}

	.stream-toolbar a {
		@apply flex shrink-0 items-center gap-1 font-semibold text-black/70 transition hover:text-[var(--primary)] dark:text-white/70;
	}

	.stream-toolbar a > :global(svg) {
		@apply text-xl transition-transform;
	}

	.stream-toolbar a:hover > :global(svg) {
		@apply translate-x-1;
	}

	.post-list {
		@apply flex flex-col gap-4;
	}
</style>
