---
import { render } from "astro:content";
import { Icon } from "astro-icon/components";
import { profileConfig, siteConfig } from "../config";
import { getSortedPosts } from "../utils/content-utils";
import { getPostUrl, url } from "../utils/url-utils";
import ImageWrapper from "./misc/ImageWrapper.astro";

const posts = await getSortedPosts();
const latestPost = posts[0];
const renderedPosts = await Promise.all(posts.map((post) => render(post)));
const totalWords = renderedPosts.reduce(
	(total, post) => total + Number(post.remarkPluginFrontmatter.words || 0),
	0,
);

const siteStartDate = new Date(`${siteConfig.siteStartDate}T00:00:00`);
const daysOnline = Math.max(
	1,
	Math.ceil((Date.now() - siteStartDate.getTime()) / 86_400_000),
);
const lastUpdated = latestPost
	? latestPost.data.updated || latestPost.data.published
	: siteStartDate;

const formatDate = (date: Date, locale: string) =>
	new Intl.DateTimeFormat(locale, {
		year: "numeric",
		month: "short",
		day: "numeric",
	}).format(date);

const formatCount = (count: number) =>
	new Intl.NumberFormat("zh-CN", { notation: "compact" }).format(count);
const toDateKey = (date: Date) => {
	const year = date.getFullYear();
	const month = String(date.getMonth() + 1).padStart(2, "0");
	const day = String(date.getDate()).padStart(2, "0");
	return `${year}-${month}-${day}`;
};

const activityCount = new Map<string, number>();
for (const post of posts) {
	const key = toDateKey(post.data.published);
	activityCount.set(key, (activityCount.get(key) || 0) + 1);
}

const today = new Date();
today.setHours(0, 0, 0, 0);
const chartEnd = new Date(today);
chartEnd.setDate(chartEnd.getDate() + (6 - chartEnd.getDay()));
const chartStart = new Date(chartEnd);
chartStart.setDate(chartStart.getDate() - 370);

const activityCells = Array.from({ length: 371 }, (_, index) => {
	const date = new Date(chartStart);
	date.setDate(chartStart.getDate() + index);
	const count = date > today ? 0 : activityCount.get(toDateKey(date)) || 0;
	return {
		date,
		count,
		isFuture: date > today,
		level: count === 0 ? 0 : Math.min(4, count),
	};
});

const monthLabels: { week: number; zh: string; en: string }[] = [];
let previousMonthKey = "";
for (let week = 0; week < 53; week++) {
	const weekStart = activityCells[week * 7]?.date;
	if (!weekStart) continue;
	const weekEnd = new Date(weekStart);
	weekEnd.setDate(weekEnd.getDate() + 6);
	const labelDate =
		weekStart.getMonth() === weekEnd.getMonth()
			? weekStart
			: new Date(weekEnd.getFullYear(), weekEnd.getMonth(), 1);
	const key = `${labelDate.getFullYear()}-${labelDate.getMonth()}`;
	if (key !== previousMonthKey) {
		monthLabels.push({
			week,
			zh: `${labelDate.getMonth() + 1}月`,
			en: labelDate.toLocaleDateString("en-US", { month: "short" }),
		});
		previousMonthKey = key;
	}
}
if (
	monthLabels.length > 1 &&
	monthLabels[1].week - monthLabels[0].week < 3
) {
	monthLabels.shift();
}
---

<div class="home-dashboard">
	<section class="profile-intro" aria-labelledby="profile-name">
		<div class="profile-avatar-wrap">
			<ImageWrapper
				src={profileConfig.avatar}
				alt="nikonikoni"
				class="profile-avatar"
			/>
		</div>
		<div class="profile-copy">
			<p class="eyebrow">
				你好，我是
			</p>
			<h1 id="profile-name">nikonikoni</h1>
			<p class="profile-lead">
				人工智能专业本科生，正在把数学基础、模型原理和工程实践整理成一份持续生长的公开笔记。
			</p>
			<div class="profile-actions">
				<span class="info-chip">
					<Icon name="material-symbols:school-outline-rounded" />
					西安交通大学 · 人工智能本科生
				</span>
				<a class="info-chip" href="https://github.com/ldx-ckz" target="_blank" rel="noreferrer">
					<Icon name="fa6-brands:github" />
					GitHub
				</a>
				<span class="info-chip">
					<Icon name="material-symbols:article-outline-rounded" />
					{posts.length}
					<span class="ui-lang-zh">篇文章</span>
					<span class="ui-lang-en">Posts</span>
				</span>
			</div>
		</div>
	</section>

	<section class="dashboard-section about-section" aria-labelledby="about-title">
		<div class="section-heading">
			<p class="section-index">01</p>
			<h2 id="about-title">
				<span class="ui-lang-zh">关于这个博客</span>
				<span class="ui-lang-en">About the Blog</span>
			</h2>
		</div>
		<div class="section-content">
			<p>
				这里记录我学习人工智能的过程：从数学与概率基础，到机器学习方法、代码实验，以及偶尔的生活观察。内容优先追求可复现、可回顾，而不是追逐短暂的热点。
			</p>
			<a class="text-link" href={url("/about/")}>
				<span class="ui-lang-zh">更多关于我与博客</span>
				<span class="ui-lang-en">More about me and the blog</span>
				<Icon name="material-symbols:arrow-forward-rounded" />
			</a>
		</div>
	</section>

	<section class="dashboard-section" aria-labelledby="education-title">
		<div class="section-heading">
			<p class="section-index">02</p>
			<h2 id="education-title">
				<span class="ui-lang-zh">教育经历</span>
				<span class="ui-lang-en">Education</span>
			</h2>
		</div>
		<div class="education-list">
			<article class="education-card">
				<div>
					<h3>西安交通大学</h3>
					<p>人工智能专业 · 本科</p>
				</div>
				<span class="education-time">2026.09 — 至今</span>
			</article>
		</div>
	</section>

	<section class="dashboard-section" aria-labelledby="focus-title">
		<div class="section-heading">
			<p class="section-index">03</p>
			<h2 id="focus-title">
				<span class="ui-lang-zh">学习方向</span>
				<span class="ui-lang-en">Current Focus</span>
			</h2>
		</div>
		<div class="focus-list">
			<article class="focus-card">
				<Icon name="material-symbols:function-rounded" />
				<div>
					<h3>数学基础</h3>
					<p>数学分析、概率论与支撑模型理解的基本工具。</p>
				</div>
			</article>
			<article class="focus-card">
				<Icon name="material-symbols:neurology-outline-rounded" />
				<div>
					<h3>机器学习</h3>
					<p>从原理、论文阅读到小型实验，建立完整知识链路。</p>
				</div>
			</article>
			<article class="focus-card">
				<Icon name="material-symbols:code-rounded" />
				<div>
					<h3>工程实践</h3>
					<p>用代码验证想法，并记录实现过程中的判断与复盘。</p>
				</div>
			</article>
		</div>
	</section>

	<section class="dashboard-section" aria-labelledby="stats-title">
		<div class="section-heading">
			<p class="section-index">04</p>
			<h2 id="stats-title">
				<span class="ui-lang-zh">博客数据</span>
				<span class="ui-lang-en">Statistics</span>
			</h2>
		</div>
		<div class="stats-grid">
			<article class="stat-card">
				<Icon name="material-symbols:schedule-rounded" />
				<strong>{daysOnline}</strong>
				<span class="ui-lang-zh">运行天数</span><span class="ui-lang-en">Days Online</span>
			</article>
			<article class="stat-card">
				<Icon name="material-symbols:calendar-month-outline-rounded" />
				<strong class="stat-date">
					<span class="ui-lang-zh">{formatDate(lastUpdated, "zh-CN")}</span>
					<span class="ui-lang-en">{formatDate(lastUpdated, "en-US")}</span>
				</strong>
				<span class="ui-lang-zh">最近更新</span><span class="ui-lang-en">Last Updated</span>
			</article>
			<article class="stat-card">
				<Icon name="material-symbols:description-outline-rounded" />
				<strong>
					{formatCount(totalWords)}
				</strong>
				<span class="ui-lang-zh">累计字数</span><span class="ui-lang-en">Total Words</span>
			</article>
		</div>
	</section>

	<section class="dashboard-section activity-section" aria-labelledby="activity-title">
		<div class="section-heading">
			<p class="section-index">05</p>
			<h2 id="activity-title">
				<span class="ui-lang-zh">写作活动</span>
				<span class="ui-lang-en">Writing Activity</span>
			</h2>
		</div>
		<div class="activity-panel">
			<div class="activity-scroll">
				<div class="month-row" aria-hidden="true">
					{monthLabels.map((label) => (
						<span style={`grid-column: ${label.week + 1}`}>
							<span class="ui-lang-zh">{label.zh}</span>
							<span class="ui-lang-en">{label.en}</span>
						</span>
					))}
				</div>
				<div class="activity-grid" aria-label="Past year writing activity">
					{activityCells.map((cell) => (
						<span
							class:list={["activity-cell", `level-${cell.level}`, { future: cell.isFuture }]}
							title={`${toDateKey(cell.date)} · ${cell.count} post${cell.count === 1 ? "" : "s"}`}
						></span>
					))}
				</div>
			</div>
			<div class="activity-summary">
				<p>
					<strong>{posts.length}</strong>
					<span class="ui-lang-zh"> 篇文章记录在案</span>
					<span class="ui-lang-en"> posts published</span>
				</p>
				<div class="legend" aria-label="Activity intensity">
					<span class="ui-lang-zh">少</span><span class="ui-lang-en">Less</span>
					<span class="activity-cell level-0"></span>
					<span class="activity-cell level-1"></span>
					<span class="activity-cell level-2"></span>
					<span class="activity-cell level-3"></span>
					<span class="activity-cell level-4"></span>
					<span class="ui-lang-zh">多</span><span class="ui-lang-en">More</span>
				</div>
			</div>
		</div>

		{latestPost && (
			<a class="latest-post" href={getPostUrl(latestPost)}>
				<div>
					<p>
						<span class="ui-lang-zh">最新文章</span>
						<span class="ui-lang-en">Latest Post</span>
					</p>
					<h3>{latestPost.data.title}</h3>
					<span>
						<span class="ui-lang-zh">{formatDate(latestPost.data.published, "zh-CN")}</span>
						<span class="ui-lang-en">{formatDate(latestPost.data.published, "en-US")}</span>
					</span>
				</div>
				<Icon name="material-symbols:arrow-forward-rounded" />
			</a>
		)}
	</section>
</div>

<style>
	.home-dashboard {
		--dashboard-border: color-mix(in srgb, var(--primary) 14%, transparent);
		@apply flex flex-col gap-5 pb-4;
	}

	.profile-intro,
	.dashboard-section {
		@apply rounded-[var(--radius-large)];
	}

	.profile-intro {
		@apply grid items-center gap-6 p-6 md:grid-cols-[9rem_1fr] md:p-9;
	}

	.profile-avatar-wrap {
		@apply aspect-square w-full max-w-36 rounded-3xl border border-black/10 shadow-sm dark:border-white/10;
	}

	.profile-avatar-wrap :global(.profile-avatar) {
		@apply h-full w-full;
	}

	.profile-copy {
		@apply min-w-0;
	}

	.eyebrow,
	.section-index {
		@apply mb-2 text-xs font-bold uppercase tracking-[0.2em] text-[var(--primary)];
	}

	.profile-copy h1 {
		@apply mb-3 text-4xl font-black tracking-tight text-black/90 dark:text-white/90 md:text-5xl;
	}

	.profile-lead {
		@apply max-w-3xl text-base leading-8 text-black/65 dark:text-white/65 md:text-lg;
	}

	.profile-actions {
		@apply mt-5 flex flex-wrap gap-2;
	}

	.info-chip {
		@apply inline-flex h-10 items-center gap-2 rounded-xl border border-black/10 bg-black/[0.025] px-3.5 text-sm font-medium text-black/65 transition hover:border-[var(--primary)] hover:text-[var(--primary)] dark:border-white/10 dark:bg-white/[0.035] dark:text-white/65;
	}

	.info-chip :global(svg) {
		@apply text-lg;
	}

	.dashboard-section {
		@apply grid gap-6 p-6 md:grid-cols-[9rem_1fr] md:p-9;
	}

	.section-heading h2 {
		@apply text-xl font-black text-black/90 dark:text-white/90;
	}

	.section-content {
		@apply text-base leading-8 text-black/65 dark:text-white/65;
	}

	.text-link {
		@apply mt-5 inline-flex items-center gap-2 rounded-xl border border-black/10 px-4 py-2.5 text-sm font-bold text-black/75 transition hover:border-[var(--primary)] hover:text-[var(--primary)] dark:border-white/10 dark:text-white/75;
	}

	.text-link :global(svg) {
		@apply text-lg transition-transform;
	}

	.text-link:hover :global(svg) {
		@apply translate-x-1;
	}

	.focus-list {
		@apply flex flex-col gap-3;
	}

	.education-list {
		@apply flex flex-col gap-3;
	}

	.education-card {
		@apply flex items-start justify-between gap-5 rounded-2xl border border-black/10 bg-black/[0.018] p-5 dark:border-white/10 dark:bg-white/[0.025];
	}

	.education-card h3 {
		@apply mb-1 text-lg font-bold text-black/85 dark:text-white/85;
	}

	.education-card p {
		@apply text-sm text-black/55 dark:text-white/55;
	}

	.education-time {
		@apply shrink-0 font-mono text-xs uppercase tracking-wider text-black/45 dark:text-white/45;
	}

	.focus-card {
		@apply flex items-start gap-4 rounded-2xl border border-black/10 bg-black/[0.018] p-5 dark:border-white/10 dark:bg-white/[0.025];
	}

	.focus-card > :global(svg) {
		@apply mt-0.5 shrink-0 text-2xl text-[var(--primary)];
	}

	.focus-card h3 {
		@apply mb-1 font-bold text-black/85 dark:text-white/85;
	}

	.focus-card p {
		@apply text-sm leading-6 text-black/55 dark:text-white/55;
	}

	.stats-grid {
		@apply grid gap-3 sm:grid-cols-3;
	}

	.stat-card {
		@apply flex min-h-36 flex-col items-center justify-center rounded-2xl border border-black/10 bg-black/[0.018] p-4 text-center dark:border-white/10 dark:bg-white/[0.025];
	}

	.stat-card :global(svg) {
		@apply mb-2 text-2xl text-[var(--primary)];
	}

	.stat-card strong {
		@apply mb-1 text-2xl font-black text-black/90 dark:text-white/90;
	}

	.stat-card strong.stat-date {
		@apply text-lg;
	}

	.stat-card > span {
		@apply text-sm text-black/50 dark:text-white/50;
	}

	.activity-panel {
		@apply min-w-0 rounded-2xl border border-black/10 bg-black/[0.018] p-4 dark:border-white/10 dark:bg-white/[0.025] md:p-5;
	}

	.activity-scroll {
		@apply overflow-x-auto pb-2;
	}

	.month-row,
	.activity-grid {
		display: grid;
		grid-template-columns: repeat(53, 11px);
		column-gap: 4px;
		width: max-content;
		min-width: 100%;
	}

	.month-row {
		@apply mb-2 h-5 text-xs text-black/45 dark:text-white/45;
	}

	.month-row > span {
		white-space: nowrap;
	}

	.activity-grid {
		grid-template-rows: repeat(7, 11px);
		grid-auto-flow: column;
		row-gap: 4px;
	}

	.activity-cell {
		@apply block h-[11px] w-[11px] rounded-[3px];
		background: color-mix(in srgb, currentColor 7%, transparent);
		color: var(--primary);
	}

	.activity-cell.level-1 {
		background: color-mix(in srgb, var(--primary) 28%, transparent);
	}

	.activity-cell.level-2 {
		background: color-mix(in srgb, var(--primary) 48%, transparent);
	}

	.activity-cell.level-3 {
		background: color-mix(in srgb, var(--primary) 70%, transparent);
	}

	.activity-cell.level-4 {
		background: color-mix(in srgb, var(--primary) 94%, transparent);
	}

	.activity-cell.future {
		@apply opacity-20;
	}

	.activity-summary {
		@apply mt-4 flex flex-col gap-3 text-sm text-black/55 dark:text-white/55 sm:flex-row sm:items-center sm:justify-between;
	}

	.activity-summary strong {
		@apply text-black/85 dark:text-white/85;
	}

	.legend {
		@apply flex items-center gap-1.5;
	}

	.latest-post {
		@apply mt-4 flex items-center justify-between gap-4 rounded-2xl border border-black/10 p-5 transition hover:-translate-y-0.5 hover:border-[var(--primary)] hover:shadow-md dark:border-white/10 md:col-start-2;
	}

	.latest-post p {
		@apply mb-1 text-xs font-bold uppercase tracking-[0.16em] text-[var(--primary)];
	}

	.latest-post h3 {
		@apply mb-1 text-lg font-bold text-black/85 dark:text-white/85;
	}

	.latest-post div > span {
		@apply text-sm text-black/45 dark:text-white/45;
	}

	.latest-post > :global(svg) {
		@apply shrink-0 text-3xl text-[var(--primary)] transition-transform;
	}

	.latest-post:hover > :global(svg) {
		@apply translate-x-1;
	}

	@media (max-width: 767px) {
		.profile-avatar-wrap {
			@apply w-24;
		}

		.dashboard-section {
			@apply gap-4;
		}
	}
</style>
